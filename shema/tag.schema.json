{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://powermatch/tag.schema.json",
  "title": "Tag",
  "type": "object",
  "required": ["id", "name", "category", "aspects"],
  "properties": {
    "id":   { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "category": {
      "type": "string",
      "enum": ["effect", "range", "cost", "timing", "type", "scholar", "other"]
    },
    "icon":       { "type": ["string", "null"] },
    "color":      { "type": ["integer", "null"] },
    "isBuiltin":  { "type": "boolean" },

    "aspects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["key", "label", "type"],
        "properties": {
          "key":   { "type": "string" },
          "label": { "type": "string" },
          "type":  {
            "type": "string",
            "enum": ["int", "double", "bool", "string",
                     "enumValue", "scale", "reference"]
          },
          "required":     { "type": "boolean" },
          "defaultValue": true,
          "minValue":     { "type": ["number", "null"] },
          "maxValue":     { "type": ["number", "null"] },
          "options": {
            "type": "array",
            "items": { "type": "string" }
          },
          "scaleKind": {
            "type": ["string", "null"],
            "enum": ["strength", "speed", "accuracy", "stamina",
                     "durability", "range", "aoe", "custom", null]
          },
          "hint": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}